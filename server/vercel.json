{
    "version": 2,
    "builds": [
      {
        "src": "app.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }

    ],
    "cors":[
      {
    "enabled": true,
    "origins": ["https://attendance-app-eight.vercel.app"],
    "methods": ["GET", "POST", "PUT"],
    "headers": ["Content-Type", "Authorization"] 
   }
    ]
}
